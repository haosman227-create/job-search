# Copy to .env.local and fill in. All values are read server-side only,
# except NEXT_PUBLIC_* which are safe to expose to the browser.

# Claude API — invoice extraction and market-price estimation (server-only).
ANTHROPIC_API_KEY=

# Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — server-only, bypasses RLS; used by background jobs.
SUPABASE_SERVICE_ROLE_KEY=

# Set to 1 to expose the internal /internal/* views (operator-only,
# cross-tenant). Leave unset in tenant-facing deployments.
INTERNAL_METRICS_ENABLED=
# Comma-separated emails allowed into /internal/* when the flag is on.
# Empty admits no one — both the flag AND the allowlist are required.
OPERATOR_EMAILS=

# Stripe billing (server-only). Leave unset to run without billing — the
# billing endpoints return 503 until all of these are present.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Price ids for each paid plan (from the Stripe dashboard).
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=
# Public base URL for Checkout success/cancel redirects (falls back to origin).
NEXT_PUBLIC_APP_URL=
